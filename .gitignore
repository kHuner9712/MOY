# ---------------------------------------------------------------------------
# 依赖与构建产物
# ---------------------------------------------------------------------------
node_modules/
.pnp/
.pnp.js
.yarn/cache
.yarn/install-state.gz
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# ---------------------------------------------------------------------------
# 测试与覆盖率
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
htmlcov/
coverage.xml
.coverage
.coverage.*
coverage.json
# CI 的 junit 报告（P0-4 起由 pytest --junitxml 生成，用于断言 skipped=0）
junit.xml
.tox/
.nox/

# ---------------------------------------------------------------------------
# 环境变量与密钥（严禁入库）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# 轻量版的样例文件必须入库（`.env.*` 会连它一起忽略）；真实 `.env.lite` 仍不入库
!.env.lite.example

# install.sh 的安装台账（9 个镜像 digest + 5 份 init 脚本指纹 + 安装时间）：
# 属**现场状态**，不入库。它一旦入库，upgrade 就会拿"别人机器的基线"去比对
# 本机，结论必然是"基线被人改过"。
deploy/.installed-manifest.json*
*.pem
*.key
secrets/

# ---------------------------------------------------------------------------
# 本地数据卷（数据库/对象存储/向量库）
# ---------------------------------------------------------------------------
deploy/data/
deploy/volumes/
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# 离线镜像包（体积大，按需分发）
# ---------------------------------------------------------------------------
deploy/offline/images/
*.tar
*.tar.gz

# ---------------------------------------------------------------------------
# 编辑器与操作系统
# ---------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp

# ---------------------------------------------------------------------------
# 工具链本地工作区（不纳入版本控制）
# ---------------------------------------------------------------------------
.workbuddy/

# QA 一次性验证产物（Sprint 0 探针脚本，保留本地历史、不入库）
apps/adapter/qa_probe/probe_contract.py
apps/adapter/qa_probe/probe_runtime.py
# 注意：qa_probe/ 下的长期资产（mock_llm.py 契约测试 mock、
# integration_real.py 真实联调脚本）必须入库，不适用本忽略规则
# 一次性排障插件（本轮用来在终端摘要被日志重绑定吞掉时落盘失败清单）不入库
apps/adapter/qa_probe/_fail_recorder.py

# 本地手工造数脚本（直接对着运行中的库 DELETE/INSERT 演示订阅行），
# 不是迁移也不是种子，无任何 CI/脚本引用——留在本地，不入库
.seed.sql

# 回滚前强制备份产物（`migrate.py --rollback` 的 pg_dump 落点）：
# 里面是整库业务数据，绝不能进版本库
deploy/migrations/rollback/*/

# ---------------------------------------------------------------------------
# 构建产物：OpenAPI 规范（CI 每次生成并归档为 artifact，不入库以避免噪声 diff）
# 基线（baseline-*.json）与冻结快照（openapi.snapshot.json）**必须入库**
# ---------------------------------------------------------------------------
docs/api/openapi.json

# 备份产物（db.dump 含全部业务数据与产物，绝不入库）
deploy/backups/
