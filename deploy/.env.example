# ===========================================================================
# 环境变量样例（部署唯一配置入口）
#
# 使用方式：
#   cp .env.example .env  然后按实际情况修改所有标有「必填」的项。
#
# 命名规范（架构文档 9.5）：全部大写 + OA_ 前缀。
#
# ⚠️ 合规待决项 D-06（缓存 / 对象存储许可证方案尚未决策）：
#   - 缓存组件当前使用 **Valkey**（BSD-3-Clause）。原 Redis 7 为 RSALv2/SSPL
#     双许可，按灰名单规则「仅独立进程调用、不可引入核心代码」处理。
#     若最终决策改回 Redis，必须保持「独立容器运行、不打包其代码」。
#   - 对象存储当前使用 **SeaweedFS 3.80**（Apache-2.0，白名单协议），提供 S3 兼容接口，
#     以独立容器方式运行，不引入其代码到核心代码库。
#     ⚠️ 换用 SeaweedFS 的原因：minio/minio 的 Docker Hub 仓库已**整体下架**
#     （实测任意 tag 拉取均返回 401，对照组同法返回 200），
#     即便锁定 AGPL 之前的版本线也拉不下来，私有化部署会直接失败。
#   上述两项均需主理人与法务/合规确认后定稿。
# ===========================================================================

# ---------------------------------------------------------------------------
# 部署模式
# ---------------------------------------------------------------------------
# saas    = 云端多租户（PostgreSQL RLS 行级隔离 + 应用层 tenant_id 双保险）
# private = 私有化单节点（单租户，默认租户 default）
#
# ⚠️ saas + oidc 的前置条件：OIDC 令牌必须包含 `tenant_id` 声明。
#    租户的可信来源只有令牌声明——前端在拿到资料前不会发租户请求头（见 ADR-0007）。
#    令牌缺该声明时，首个身份请求会 fail-fast 返回 20001，而不是静默落到 default 租户。
#    private 模式不读该请求头、恒用 default，不受影响。
OA_DEPLOY_MODE=private

# 离线模式：true 时全部镜像从本地离线包加载，不访问公网
OA_OFFLINE_MODE=true

# 镜像版本标签（私有化交付时统一替换为离线包中的版本）
OA_IMAGE_TAG=1.0.0

# ---------------------------------------------------------------------------
# 基础设施：PostgreSQL
# ---------------------------------------------------------------------------
OA_POSTGRES_USER=officeai
OA_POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
OA_POSTGRES_DB=officeai

# 底座数据库名（与办公平台业务库分离）
OA_DIFY_DB=dify

# 身份底座数据库名
OA_KEYCLOAK_DB=keycloak

# ---------------------------------------------------------------------------
# 基础设施：缓存（⚠️ D-06 待决，当前为 Valkey/BSD-3）
# ---------------------------------------------------------------------------
OA_VALKEY_PASSWORD=CHANGE_ME_STRONG_PASSWORD
OA_VALKEY_MAXMEMORY=2gb

# 若最终决策改回 Redis 7（RSALv2/SSPL），必须以独立容器运行、不引入其代码，
# 并将下方连接串中的 valkey 主机名替换为 redis。
# OA_REDIS_HOST=redis
# OA_REDIS_PORT=6379

# ---------------------------------------------------------------------------
# 基础设施：S3 兼容对象存储（SeaweedFS，Apache-2.0）
# ⚠️ D-06 待决：对象存储最终选型需主理人与法务/合规确认
# ---------------------------------------------------------------------------
# 镜像标签已锁定为 RELEASE.2021-04-22 系列（compose 中固定，不可升级到 AGPL 主线）
OA_OBJECT_STORE_ACCESS_KEY=officeai
OA_OBJECT_STORE_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
OA_OBJECT_STORE_BUCKET=officeai
# 底座对象桶
OA_DIFY_S3_BUCKET=dify
# S3 region（Dify OpenDAL 与 Milvus 均要求显式声明；SeaweedFS 不校验取值）
OA_OBJECT_STORE_REGION=us-east-1

# 对象存储对外端口（私有化单机部署时按需映射）
# S3 兼容接口端口（适配层与底座通过它访问对象存储）
OA_OBJECT_STORE_API_PORT=8333
# 管理端口（SeaweedFS filer / 管理界面）
OA_OBJECT_STORE_ADMIN_PORT=23646

# ---------------------------------------------------------------------------
# 基础设施：向量库 Milvus
# ---------------------------------------------------------------------------
# 连接串仅适配层可见；前端与插件严禁感知（架构文档 1.4）
OA_MILVUS_URI=http://milvus:19530
OA_MILVUS_PORT=19530
OA_MILVUS_METRICS_PORT=9091

# ---------------------------------------------------------------------------
# 底座（Dify）配置 —— 仅适配层可见，严禁出现在 apps/web
# ---------------------------------------------------------------------------
OA_DIFY_MODE=api
OA_DIFY_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING

# 各能力档位对应的底座应用密钥（Q2 决策变化时只改这里与路由表）
# 路由映射见 apps/adapter/app/registry/profile_routes.yaml
# 注（阶段四 P4-10）：这 4 个档位密钥已在 Settings 里强类型声明
# （`dify_code_app_key` / `..._long_context_app_key` / `..._reasoning_app_key` /
#  `..._fallback_app_key`），变量名与路由表逐字对应。缺省空串 = 该档不可用
# （M3 目录 `status=unavailable`），不会再静默回落到通用档。
OA_DIFY_DEFAULT_APP_KEY=
# Agent 任务专用工作流应用密钥（与对话应用分离；缺省回退默认密钥）
OA_DIFY_AGENT_APP_KEY=
OA_DIFY_FALLBACK_APP_KEY=
OA_DIFY_CODE_APP_KEY=
OA_DIFY_LONG_CONTEXT_APP_KEY=
OA_DIFY_REASONING_APP_KEY=

# 代码沙箱密钥
OA_DIFY_SANDBOX_KEY=CHANGE_ME_STRONG_PASSWORD

# 私有化模式的 SSRF 代理（阻断内网访问）
OA_SSRF_PROXY_URL=http://ssrf_proxy:3128

# ---------------------------------------------------------------------------
# 插件守护进程（plugin_daemon）内部 API 密钥
#
# 审计 OA-AUDIT-001 / P0-3 新增登记：这两个变量此前**未登记**，且编排里带
# 明文兜底值（不配也能启动）。现改为缺失即拒绝启动，因此**必须**在此配置。
#
# 生成方式（两枚请使用不同值）：
#   openssl rand -base64 32
#
# ⚠️ 安全提示：编排中曾出现的兜底值已随仓库提交公开，视为**已泄露**，
#    任何沿用旧值的部署都必须轮换这两枚密钥。
# ---------------------------------------------------------------------------
OA_PLUGIN_DAEMON_KEY=CHANGE_ME_STRONG_RANDOM_32_BYTES_BASE64
OA_PLUGIN_INNER_API_KEY=CHANGE_ME_STRONG_RANDOM_32_BYTES_BASE64

# ---------------------------------------------------------------------------
# 身份底座（Keycloak）配置
# ---------------------------------------------------------------------------
OA_KEYCLOAK_ADMIN=admin
OA_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
OA_KEYCLOAK_REALM=officeai
OA_KEYCLOAK_CLIENT_ID=officeai-adapter
OA_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_STRONG_PASSWORD

# ---------------------------------------------------------------------------
# 适配层运行配置（apps/adapter）
# ---------------------------------------------------------------------------
OA_ENV=production
OA_API_PREFIX=/api/v1
OA_HOST=0.0.0.0
OA_ADAPTER_PORT=8000

# 日志：生产固定 JSON 结构化输出
OA_LOG_LEVEL=INFO
OA_LOG_FORMAT=json

# 鉴权模式：
#   oidc = 生产（校验签名/过期/签发者/受众）
#   stub = 仅开发调试（解析 JWT 载荷但不验签，严禁用于生产）
OA_AUTH_MODE=oidc
OA_JWT_SECRET=CHANGE_ME_STRONG_PASSWORD
OA_JWT_ALGORITHM=HS256
OA_JWT_AUDIENCE=officeai-adapter
OA_JWT_ISSUER=officeai

# 私有化模式默认租户
OA_DEFAULT_TENANT_ID=default

# 跨租户切换的成员关系校验（SaaS 多租户场景有效）：
#   auto   = 默认，SaaS + 非 stub 模式下校验（推荐）
#   always = 任何模式都校验
#   off    = 紧急回退，跳过校验（安全降级，止血后必须改回 auto）
# OA_TENANT_MEMBERSHIP_CHECK=auto

# 真实下游调用开关：
#   T01 骨架阶段为 false（桩模式，不产生真实底座请求）
#   T02/T04 联调后置为 true
OA_DOWNSTREAM_ENABLED=false

# 幂等与限流后端（多副本部署必须使用 redis）
OA_IDEMPOTENCY_BACKEND=memory
OA_IDEMPOTENCY_TTL_SECONDS=86400
OA_RATELIMIT_ENABLED=true
OA_RATELIMIT_DEFAULT_PER_MINUTE=120

# 上传限制
OA_MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# 阶段二新增：业务库（D-02，架构文档 2.1 / 11.5）
# ---------------------------------------------------------------------------
# 业务数据存储：postgres（生产唯一允许值）| memory（仅 development/test）
#   memory 模式不创建任何数据库引擎，也不执行迁移（离线单测/T01 演示用）
OA_BUSINESS_STORE=postgres
# 业务库连接串：⚠️ 必须使用 officeai_app（NOSUPERUSER + NOBYPASSRLS）
#   officeai 是 initdb 创建的超级用户，永久绕过行级安全策略（BYPASSRLS），
#   用它连库等于多租户隔离失效；/readyz 的 db_privilege 自检会判 not_ready。
#   officeai_app 由 deploy/init-app-role.sql 创建（占位密码），
#   首次部署后必须先执行：ALTER ROLE officeai_app PASSWORD '<强随机密码>';
#   再把该密码填到本变量，否则应用无法连接（刻意设计）。
OA_DATABASE_URL=postgresql+asyncpg://officeai_app:CHANGE_ME_APP_PASSWORD@postgres:5432/officeai
# 连接池：副本数 × (POOL_SIZE + MAX_OVERFLOW) ≤ PG max_connections × 0.6
OA_DB_POOL_SIZE=10
OA_DB_MAX_OVERFLOW=5
OA_DB_POOL_TIMEOUT_SECONDS=5
# 启动时自动增量执行 deploy/migrations
#
# ⚠️ 阶段四 T4-01.4 起默认 **false**：多副本滚动发布时"每个副本启动都跑迁移"
#    会在没有锁的窗口里并发执行 DDL（迁移锁已加，但正确姿势仍是单实例执行）。
#    生产升级改为独立一次性 Job：
#      docker compose --profile migrate run --rm migrate
#    development/test 想图省事可改回 true（单副本、无并发场景）。
OA_DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# 阶段二新增：per-kb 凭据加密（D-10，架构文档 2.3 / 11.5）
# ---------------------------------------------------------------------------
# 32 字节密钥的 base64，生成方式：
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ⚠️ OA_BUSINESS_STORE=postgres 或 env=production 时缺失即启动失败（30004）
OA_CREDENTIAL_ENCRYPTION_KEY=
# 轮换期旧密钥，格式 "1:base64key,2:base64key"（解密时按 key_version 选密钥）
OA_CREDENTIAL_ENCRYPTION_KEYS_LEGACY=
# bound = 按库凭据优先（正常）；global = 应急强制全走全局凭据（仅故障时使用）
OA_CREDENTIAL_MODE=bound
# 凭据密文缓存 TTL（秒）；缓存的是密文，不是明文
OA_CREDENTIAL_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# 阶段二新增：用量计量（D-12，架构文档 2.5 / 11.5）
# ---------------------------------------------------------------------------
# 是否写入新的用量事件与月度聚合。
# true（默认）= 正常计量；false = 回滚口径，只读历史聚合（M4/BL5 仍返回历史数字）
OA_USAGE_WRITE_ENABLED=true
# 一个「字数额度」对应的字符数。默认 1：中文 1 字 ≈ 1 字数额度
OA_USAGE_CHARS_PER_UNIT=1
# 流式中断且下游未回传输入用量时的兜底额度（常量登记在配置，不改代码调参）
OA_USAGE_ESTIMATE_PROMPT_UNITS=800

# ---------------------------------------------------------------------------
# 阶段二新增：计费与支付（B09，架构文档 4.5 / 11.5）
# ---------------------------------------------------------------------------
# 支付渠道：wechat_pay（生产）| fake（仅测试与本地联调，不发任何真实请求）
#   ⚠️ 真实环境（staging/production）即使处于桩模式也不会自动回落 fake，
#   缺密钥时只在下单/验签时返回「服务配置异常」（30004），不会静默放行。
OA_PAY_CHANNEL=wechat_pay
# 微信支付商户号（缺失时启动不报错，下单时才报 30004）
OA_PAY_MCH_ID=
# APIv3 密钥（用于回调验签；**严禁**写入任何真实密钥到本文件或仓库）
OA_PAY_API_V3_KEY=
# 商户 API 证书序列号
OA_PAY_CERT_SERIAL=
# 商户私钥文件路径（容器内绝对路径，文件由部署侧挂载，不进镜像）
OA_PAY_PRIVATE_KEY_PATH=
# 支付结果回调地址（必须在公网可达，且与本服务路由 /api/v1/billing/payments/callback 一致）
OA_PAY_NOTIFY_URL=
# 对公转账收款信息（JSON 字符串，原样展示给企业用户；示例：）
#   {"account_name":"某某科技有限公司","bank_name":"招商银行北京分行","account_no":"1109********1234"}
OA_PAY_BANK_INFO=
# 订单未支付自动关闭的分钟数：超过后订单置为 closed，企业可重新下单
OA_ORDER_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# 阶段四新增：数据保留期与记忆（架构 §3.5 / §3.3，Settings 已强类型声明）
#
# 保留期是合规条款的一部分（合同里写具体天数），因此**必须可配**，
# 不得改代码调参。消费者：后台任务 retention_cleanup（T4-05.3）。
# ---------------------------------------------------------------------------
# 审计日志保留天数。⚠️ 由 **DBA** 执行（应用角色对 audit_log 无 DELETE 权限）
OA_RETENTION_AUDIT_DAYS=180
# 用量事件保留月数（13 = 12 个月账单 + 1 个月缓冲）
OA_RETENTION_USAGE_MONTHS=13
# 插件任务/产物保留天数
OA_RETENTION_TASK_DAYS=180
# 会话保留天数（硬删）
OA_RETENTION_CONVERSATION_DAYS=365
# 会话软删后可恢复天数（删除接口回 recoverable_until）
OA_CONVERSATION_SOFT_DELETE_RECOVER_DAYS=30
# 单用户记忆条数上限（超出按最久未命中 + 低置信度优先淘汰）
OA_MEMORY_MAX_PER_USER=200
# 每 N 轮对话触发一次事实抽取（0 = 关闭抽取）
OA_MEMORY_EXTRACT_EVERY_TURNS=10

# ---------------------------------------------------------------------------
# 阶段四新增：记忆向量化（架构 §3.3.1 / 决策 A-1）
#
# ⚠️ 默认关闭：Dify Service API 不提供 raw embedding 接口，DeepSeek 系模型
#    也没有 embeddings 端点。关闭时召回退化为「类别 + 时间 + 置信度」，
#    去重退化为 difflib 比例比较——能力可用，只是语义精度下降。
#    客户自带 OpenAI 兼容 embeddings 服务时再打开并填下面四项。
# 维度固定进向量索引（vector(N)），换模型必须重建该列（见运维手册）。
# ---------------------------------------------------------------------------
OA_MEMORY_EMBEDDING_ENABLED=false
OA_MEMORY_EMBEDDING_DIM=1024
OA_MEMORY_EMBEDDING_MODEL=
OA_MEMORY_EMBEDDING_BASE_URL=
OA_MEMORY_EMBEDDING_API_KEY=
OA_MEMORY_EMBEDDING_TIMEOUT_SECONDS=5
OA_MEMORY_EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# 前端配置（apps/web）
# ---------------------------------------------------------------------------
# 浏览器可见的唯一外部依赖：自研统一适配层地址
# ⚠️ 严禁在此填写任何底座地址/端口/路径（架构文档 1.4）
OA_WEB_PORT=3000
OA_WEB_ADAPTER_BASE_URL=http://localhost:8000

# 统一登录（**构建期生效**，必填；否则前端没有可用的登录入口：
# 登录页只显示「统一登录尚未配置，请联系管理员」）
# - 两项都是公开接入信息，不含任何密钥，会被内联进浏览器产物；
# - 前端是**公开客户端**，采用浏览器内 PKCE，不需要也不允许填客户端密钥；
# - ⚠ 改完必须 `docker compose build web` 重新构建，`restart` 不生效
#   （NEXT_PUBLIC_* 在构建期内联，运行期改环境变量无效）；
# - 回跳地址 = 本服务对外地址 + /auth/callback（如 https://moy.example.com/auth/callback），
#   必须在统一登录侧登记一致，否则登录会被拒。
OA_WEB_OIDC_ISSUER=
OA_WEB_OIDC_CLIENT_ID=

# ---------------------------------------------------------------------------
# 监控告警
# ---------------------------------------------------------------------------
# Grafana 已于 V1.0 移除（docs/decisions/0004 第二章）：AGPL-3.0 且
# AGPL 前版本线在 Docker Hub 已不存在，看板不属 V1.0 验收项。
OA_PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# 私有化 License 授权（架构文档 1.3）
# ---------------------------------------------------------------------------
# License 校验通过环境变量注入，T02 实现校验逻辑
OA_LICENSE_KEY=
OA_LICENSE_SEAT_COUNT=50
