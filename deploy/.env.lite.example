# ===========================================================================
# 轻量版环境变量样例（deploy/.env.lite.example → deploy/.env.lite）
#
# 用法：
#   cp deploy/.env.lite.example deploy/.env.lite
#   然后替换**所有** `CHANGE_ME_*`（validate_lite_up.sh 会拒绝任何残留）。
#
# 与标准版 .env.example 的差异：
#   - 不再有 Milvus / 对象存储（SeaweedFS）相关变量：轻量版向量库用 pgvector、
#     对象存储用本地卷（见 docker-compose.lite.yml 文件头）。
#   - 不再有 dify-sandbox / ssrf_proxy 相关变量：这两个容器不在 9 个预算内。
#   - 新增 OA_LITE_* 三项：入口端口、对外基址、控制台端口。
#
# ⚠ 本文件只放**轻量版实际消费**的键。多余变量（如 OA_MILVUS_URI）写进来
#    不会报错，但会让人误以为轻量版还有那套组件。
#
# 生成随机口令（Git Bash / Linux 均可）：
#   openssl rand -hex 24               # 口令类：PG / Valkey / Keycloak / 应用角色
#                                      # 用 hex 而不是 base64：口令要嵌进 DSN 与 URL，
#                                      # base64 的 + / = 需要转义，现场极易配出坏连接串
#   openssl rand -base64 32            # 密钥类：Dify SECRET_KEY / plugin 两枚
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#                                      # 凭据加密密钥（必须是 32 字节的 base64）
#
# 走 `deploy/install.sh` 安装时**无需手工执行上述命令**：脚本会从本文件复制出
# `.env.lite` 并自动生成全部 9 项口令/密钥（`generate_env_file()` 里的 env_set）。
# 上面这些命令是手工部署（不经 install.sh）时的替代路径。
# `deploy/validate_secrets.py` 会校验「本文件的每个密钥类占位值都有 env_set 生成路径」。
# ===========================================================================

# ---------------------------------------------------------------------------
# 部署形态
# ---------------------------------------------------------------------------
# 轻量版固定 private（单租户）。改 saas 会让适配层按多租户解析上下文，
# 但轻量版没有租户注册链路，结果是所有请求都找不到租户。
# 因此轻量版不读 `X-Tenant-Id` 请求头、恒用 `default`；saas 形态见 `.env.example` 与 ADR-0007。
OA_DEPLOY_MODE=private
# 生产环境：production + stub 的组合会被启动校验拒绝（30004），这是故意的
OA_ENV=production
OA_AUTH_MODE=oidc
# 离线交付：true 表示镜像已预加载，不从公网拉取
OA_OFFLINE_MODE=true
# 镜像标签（离线包内的版本号；换版本时这里必须同步）
OA_IMAGE_TAG=1.0.0

# ---------------------------------------------------------------------------
# 入口（只有 proxy 映射宿主端口）
# ---------------------------------------------------------------------------
# 宿主监听端口。默认 80；80 被占用时改成 8080 等，**同时**改下方 PUBLIC_URL。
OA_LITE_PROXY_PORT=80
# 对外基址：浏览器地址栏里看到的那个地址。Dify 用它生成文件/回调链接，
# 写成内网服务名（http://dify-api:5001）会让下载链接在客户电脑上打不开。
# ⚠ 端口必须与 OA_LITE_PROXY_PORT 一致，否则 validate_lite_up.sh 会告警。
OA_LITE_PUBLIC_URL=http://localhost
# 通用对外基址（K1 / R4）：决定 KC_HOSTNAME、两个 issuer 与 Cookie `Secure`。
# ⚠ 轻量版**不要**在这里写 OA_PUBLIC_BASE_URL —— 编排里是
#   `OA_PUBLIC_BASE_URL: ${OA_LITE_PUBLIC_URL}`（插值）。再写一个字面量会让
#   "谁生效"取决于变量替换顺序，变成更难查的坑。改对外地址只改上面那一行。
# Dify 控制台的宿主端口（profile admin 才起；只发布到 127.0.0.1）
OA_LITE_DIFY_WEB_PORT=3001

# ---------------------------------------------------------------------------
# 统一登录（**构建期生效**）
# ---------------------------------------------------------------------------
# 两项都是公开接入信息（不含密钥），构建时内联进前端产物。
# ⚠ 改完必须 `docker compose -f docker-compose.lite.yml build web` 重新构建；
#   `restart` 不生效（NEXT_PUBLIC_* 是构建期常量）。
# 留空 = 登录页只显示「统一登录尚未配置」，登录入口不可达，私有化交付即不可登录。
# 回跳地址 = ${OA_LITE_PUBLIC_URL}/auth/callback，必须在统一登录侧登记一致。
# install.sh 会按对外基址自动渲染这两项（<基址>/realms/<realm> 与公开 client id）。
OA_WEB_OIDC_ISSUER=http://localhost/realms/officeai
OA_WEB_OIDC_CLIENT_ID=officeai-adapter

# ---------------------------------------------------------------------------
# 基础设施：PostgreSQL（业务 / 身份 / Dify / 插件守护 四库共用一个实例）
# ---------------------------------------------------------------------------
# P1-17（弱默认账号）：`officeai` 是 initdb 超级用户（BYPASSRLS），业务流量走
# `officeai_app`，本账号只用于初始化与运维直连。**不改成待填形态**：compose 会把
# 字面量 `<请填写>` 原样传给 postgres，模板抄下来直接起不来（N3 的坑）。
# 生产建议：口令用 24 字节随机值（install.sh 已自动生成），并收窄该账号使用范围。
OA_POSTGRES_USER=officeai
OA_POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
OA_POSTGRES_DB=officeai
# Dify 库与身份库名（init-databases.sql 首次启动时创建）
OA_DIFY_DB=dify
OA_KEYCLOAK_DB=keycloak

# ---------------------------------------------------------------------------
# 基础设施：缓存（Valkey，BSD-3-Clause 白名单）
#
# 一个实例三个库：db0 适配层（幂等/限流/缓存）、db1 Dify celery、db2 插件守护。
# ⚠ 不要给 Dify 单独起一个 Valkey：那是 +3 个容器换不来的收益（轻量版省内存的关键）。
# ---------------------------------------------------------------------------
OA_VALKEY_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# ---------------------------------------------------------------------------
# 身份底座（Keycloak）
# ---------------------------------------------------------------------------
# P1-17（弱默认账号）：`admin` 是 Keycloak 内置管理员用户名（全行业默认值）。
# 不改名字面量（它是 master realm 的引导账号），生产建议首次登录后另建专用管理员。
OA_KEYCLOAK_ADMIN=admin
OA_KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
OA_KEYCLOAK_REALM=officeai
OA_KEYCLOAK_CLIENT_ID=officeai-adapter
OA_KEYCLOAK_CLIENT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_24

# ---------------------------------------------------------------------------
# 底座（Dify）—— 仅适配层可见，严禁出现在前端产物里
# ---------------------------------------------------------------------------
OA_DIFY_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_24

# 插件守护进程两枚内部密钥（缺失即拒绝启动；两枚必须不同）
# 审计 OA-AUDIT-001：这两枚曾有明文兜底值并随仓库公开，视同已泄露，不得沿用旧值。
OA_PLUGIN_DAEMON_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
OA_PLUGIN_INNER_API_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# 4 个能力档位对应的 Dify 应用密钥（缺省空串 = 该档在 M3 目录里显示 unavailable）
# 首次交付时由部署工具（dify-web 控制台导入应用后）填入
OA_DIFY_DEFAULT_APP_KEY=
OA_DIFY_AGENT_APP_KEY=
OA_DIFY_CODE_APP_KEY=
OA_DIFY_LONG_CONTEXT_APP_KEY=
OA_DIFY_REASONING_APP_KEY=
OA_DIFY_FALLBACK_APP_KEY=

# ---------------------------------------------------------------------------
# 适配层（apps/adapter）
# ---------------------------------------------------------------------------
OA_API_PREFIX=/api/v1
OA_LOG_LEVEL=INFO
OA_LOG_FORMAT=json

# JWT：production + 空 OA_JWT_SECRET 会直接启动失败（30004）。
# 这是 OIDC 校验与产物下载令牌共用的签名密钥。
# 占位值刻意写到 32 字符以上：保留不改时报的是"命中占位值特征"（准确），
# 而不是"长度不足"（会把人引去加长度，实际该做的是换成随机密钥）。
# install.sh 会无条件用 `openssl rand -hex 24` 覆盖本项，手改仅用于本地调试。
OA_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
OA_JWT_ALGORITHM=HS256
OA_JWT_AUDIENCE=officeai-adapter
# `iss` 必须与 Keycloak 实际发出的逐字符相等。JWKS 拉取**不用**它（走内网 base_url）。
OA_JWT_ISSUER=http://localhost/realms/officeai
OA_DEFAULT_TENANT_ID=default

# 业务库连接串：**必须**用应用角色 officeai_app（NOSUPERUSER + NOBYPASSRLS）。
#   officeai 是 initdb 创建的超级用户，永久绕过行级安全策略；
#   用它连库等于多租户隔离失效，/readyz 的 db_privilege 自检会判 not_ready。
# officeai_app 由 deploy/init-app-role.sql 以占位口令创建，首次部署后必须：
#   docker exec -it oal-postgres psql -U officeai -d officeai \
#     -c "ALTER ROLE officeai_app PASSWORD '<新口令>';"
# 再把同一口令填到下面（此处刻意要求人工介入，避免默认口令上线）。
OA_DATABASE_URL=postgresql+asyncpg://officeai_app:CHANGE_ME_APP_PASSWORD@postgres:5432/officeai
# 连接池：单实例 × (POOL_SIZE + MAX_OVERFLOW) 要明显小于 PG 的 max_connections=100
OA_DB_POOL_SIZE=10
OA_DB_MAX_OVERFLOW=5
OA_DB_POOL_TIMEOUT_SECONDS=5
# 业务存储必须是 postgres：默认值 memory 只用于单测，不落库
OA_BUSINESS_STORE=postgres
# 迁移**不进 Web 启动**（架构 §9.4）：由 profiles:[migrate] 的一次性 Job 执行。
# 保持 false，不要为了"省一步"改成 true——多副本同时启动会并发跑 DDL。
OA_DB_AUTO_MIGRATE=false

# per-kb 凭据加密密钥（32 字节的 base64）。
# business_store=postgres 或 env=production 时**缺失即启动失败**（30004）——
# 让"漏填"在启动时暴露，而不是等第一个用户点知识库才报错。
OA_CREDENTIAL_ENCRYPTION_KEY=
# 轮换期旧密钥，格式 "1:base64key,2:base64key"（解密按 key_version 选）
OA_CREDENTIAL_ENCRYPTION_KEYS_LEGACY=
# bound = 按库凭据优先（正常）；global = 应急强制全走全局凭据
OA_CREDENTIAL_MODE=bound
OA_CREDENTIAL_CACHE_TTL_SECONDS=300

# 幂等与限流后端：单实例也建议用 redis（重启后幂等键不丢，避免重复计费/重复建单）
# R2-ENG-01（审计 2026-10-29）：限流后端独立成 OA_RATELIMIT_BACKEND 并真实生效
OA_IDEMPOTENCY_BACKEND=redis
OA_IDEMPOTENCY_TTL_SECONDS=86400
OA_RATELIMIT_BACKEND=redis
OA_RATELIMIT_ENABLED=true
OA_RATELIMIT_DEFAULT_PER_MINUTE=120

# 上传上限：**必须与 nginx 的 client_max_body_size 50m 一致**
# （nginx 比后端小 → 用户拿到纯文本 413、前端 unwrap 会崩；比后端大 → 白走一趟）
OA_MAX_UPLOAD_BYTES=52428800

# 真实下游调用开关：私有化必须 true（false 只用于无底座的开发桩）
OA_DOWNSTREAM_ENABLED=true

# 用量计量
OA_USAGE_WRITE_ENABLED=true
OA_USAGE_CHARS_PER_UNIT=1
OA_USAGE_ESTIMATE_PROMPT_UNITS=800

# ---------------------------------------------------------------------------
# 数据保留期与记忆（合同条款的一部分，必须可配，不得改代码调参）
# ---------------------------------------------------------------------------
OA_RETENTION_AUDIT_DAYS=180
OA_RETENTION_USAGE_MONTHS=13
OA_RETENTION_TASK_DAYS=180
OA_RETENTION_CONVERSATION_DAYS=365
OA_CONVERSATION_SOFT_DELETE_RECOVER_DAYS=30
OA_MEMORY_MAX_PER_USER=200
OA_MEMORY_EXTRACT_EVERY_TURNS=10

# ---------------------------------------------------------------------------
# 记忆向量化（默认关闭）
#
# Dify Service API 不提供 raw embedding 接口，DeepSeek 系模型也没有 embeddings 端点。
# 关闭时召回退化为「类别 + 时间 + 置信度」、去重退化为 difflib 比例比较——
# 能力可用，只是语义精度下降。客户自带 OpenAI 兼容 embeddings 服务时再打开。
# 维度固定进向量索引（vector(N)），换模型必须重建该列。
# ---------------------------------------------------------------------------
OA_MEMORY_EMBEDDING_ENABLED=false
OA_MEMORY_EMBEDDING_DIM=1024
OA_MEMORY_EMBEDDING_MODEL=
OA_MEMORY_EMBEDDING_BASE_URL=
OA_MEMORY_EMBEDDING_API_KEY=
OA_MEMORY_EMBEDDING_TIMEOUT_SECONDS=5
OA_MEMORY_EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# 计费与支付（轻量版默认不开渠道；下单时才校验，缺失只返回 30004 不静默放行）
# ---------------------------------------------------------------------------
OA_PAY_CHANNEL=wechat_pay
OA_ORDER_EXPIRE_MINUTES=30
# OA_PAY_MCH_ID=
# OA_PAY_API_V3_KEY=
# OA_PAY_CERT_SERIAL=
# OA_PAY_PRIVATE_KEY_PATH=
# OA_PAY_NOTIFY_URL=
# OA_PAY_BANK_INFO=

# ---------------------------------------------------------------------------
# License（架构文档 1.3）
# ---------------------------------------------------------------------------
OA_LICENSE_KEY=
OA_LICENSE_SEAT_COUNT=50
