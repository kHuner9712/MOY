{
  "realm": "officeai",
  "displayName": "OfficeAI CI (E2E)",
  "enabled": true,
  "sslRequired": "none",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,

  "bruteForceProtected": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "editUsernameAllowed": false,

  "clients": [
    {
      "clientId": "officeai-adapter",
      "name": "OfficeAI CI (public client, PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "consentRequired": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,

      "rootUrl": "http://localhost:3100",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:3100/auth/callback"],
      "webOrigins": ["http://localhost:3100"],

      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*"
      },

      "protocolMappers": [
        {
          "name": "audience-officeai-adapter",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "officeai-adapter",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],

  "roles": {
    "realm": [
      { "name": "member", "description": "企业普通成员（对话/知识库读写）" },
      { "name": "org_admin", "description": "企业管理员（插件安装/成员管理）" }
    ]
  },

  "users": [
    {
      "username": "e2e.user",
      "enabled": true,
      "realmRoles": ["member", "org_admin"],
      "email": "e2e.user@example.com",
      "emailVerified": true,
      "firstName": "E2E",
      "lastName": "User",
      "attributes": {
        "tenant_id": ["default"]
      },
      "credentials": [
        {
          "type": "password",
          "value": "e2e-pass-2026",
          "temporary": false
        }
      ]
    }
  ]
}
