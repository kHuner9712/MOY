{
  "name": "@officeai/web",
  "version": "1.0.0",
  "private": true,
  "description": "企业级跨生态办公 AI 平台 · 前端交互层（Next.js 14 App Router）",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "scan:banned": "node scripts/check-banned-terms.mjs",
    "scan:banned-built": "node scripts/check-banned-terms.mjs --built",
    "scan:words": "node scripts/check-banned-terms.mjs --check-words",
    "scan:self-test": "node scripts/check-banned-terms.mjs --self-test",
    "scan:placeholders": "node scripts/check-no-placeholders.mjs",
    "scan:placeholders-self-test": "node scripts/check-no-placeholders.mjs --self-test",
    "scan:pages": "node scripts/check-page-states.mjs",
    "scan:contract": "node scripts/check-plugin-contract.mjs",
    "scan:contract-self-test": "node scripts/check-plugin-contract.mjs --self-test",
    "scan:workbench": "node scripts/check-workbench-host.mjs",
    "scan:workbench-self-test": "node scripts/check-workbench-host.mjs --self-test",
    "scan:capability": "node scripts/check-capability-consistency.mjs",
    "scan:capability-warn": "node scripts/check-capability-consistency.mjs --warn-only",
    "scan:capability-self-test": "node scripts/check-capability-consistency.mjs --self-test",
    "scan:pages-self-test": "node scripts/check-page-states.mjs --self-test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@tanstack/react-query": "^5.5.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.454.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.53.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.4.38",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}