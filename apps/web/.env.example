# ---------------------------------------------------------------------------
# 前端环境变量（仅公开变量以 NEXT_PUBLIC_ 前缀暴露给浏览器）
#
# 红线：此处**不得**出现任何底座地址/端口/路径。
# 前端只允许知道自研统一适配层的地址，底座形态由适配层屏蔽。
# ---------------------------------------------------------------------------

# 自研统一适配层地址（唯一允许配置的外部依赖）
#
# **缺省留空 = 同源相对路径**（边缘化 / 反代部署的推荐口径）：浏览器与适配层同源，
# 由编排层把 `/api/v1` 与 `/sso` 反代到适配层。这样浏览器既不直连后端端口，
# 会话 Cookie 也不必开 `SameSite=None`（跨源才需要，等于降安全基线）。
# 只有「本地 `next dev` 且未挂反代」这类直连开发场景才需要显式填写：
# NEXT_PUBLIC_ADAPTER_BASE_URL=http://127.0.0.1:8000

# 统一登录（**前端已不再需要**：P0-5 路线 A 之后，身份服务地址、客户端标识、
# 回跳地址与授权范围全部由适配层的 `/sso/*` 端点持有，浏览器侧不生成 PKCE、
# 不拼授权地址、也不持有令牌。保留两行仅为让旧部署脚本的变量校验不报错，
# 留空即可。）NEXT_PUBLIC_OIDC_ISSUER / NEXT_PUBLIC_OIDC_CLIENT_ID 已停用。
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=

# 应用基础信息
NEXT_PUBLIC_APP_NAME=企业级办公 AI 平台
NEXT_PUBLIC_APP_VERSION=1.0.0

# 功能开关
NEXT_PUBLIC_ENABLE_PLUGIN_MARKET=false
NEXT_PUBLIC_ENABLE_WORKFLOW_VISUALIZER=false
